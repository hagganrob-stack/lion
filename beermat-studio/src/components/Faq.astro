---
import { faqs } from '../data/content';
---
<section class="section section-tint" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq-wrap">
    <h2 id="faq-title">Questions pub landlords ask</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
