---
import MatLogo from './MatLogo.astro';
import { site, phoneHref } from '../data/site';
import { hasTracking } from '../data/site';
---
<footer class="site-footer on-dark">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-brand"><MatLogo size={30} /> <span>Beermat Studio</span></p>
      <p>Built in {site.town} by {site.founder}.</p>
      {site.legalLine && <p class="legal">{site.legalLine}</p>}
    </div>
    <div>
      <p class="footer-head">Get in touch</p>
      <ul class="footer-links">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {site.phone && <li><a href={phoneHref}>{site.phone}</a></li>}
      </ul>
    </div>
    <div>
      <p class="footer-head">The small print</p>
      <ul class="footer-links">
        <li><a href="/privacy">Privacy policy</a></li>
        {hasTracking && <li><button type="button" class="link-button" data-cookie-settings>Cookie settings</button></li>}
      </ul>
    </div>
  </div>
</footer>
