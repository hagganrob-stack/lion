---
import SectionLabel from './SectionLabel.astro';
const events = [
  { day: 'Tue', date: '17', name: 'Quiz night', meta: '8pm', note: 'Teams of up to six. Bring a pen.' },
  { day: 'Fri', date: '20', name: 'Live music', meta: '9pm', note: 'Local band on stage.' },
  { day: 'Sun', date: '22', name: 'Sunday roast', meta: 'Till 5pm', note: 'Booking advised.' },
];
---
<section class="section section-raised" id="how-it-works" aria-labelledby="how-title">
  <div class="container">
    <SectionLabel label="How it works" />
  </div>
  <div class="container how-grid">
    <div class="how-copy">
      <h2 id="how-title" class="h2">How the events calendar works</h2>
      <p class="intro">
        It’s a Google Form. If you can fill in a form on your phone, you can keep your what’s on up to date.
      </p>
      <ol class="steps">
        <li>
          <h3>Open the form on your phone</h3>
          <p>Save it to your home screen. It’s a simple Google Form, so there’s nothing new to learn.</p>
        </li>
        <li>
          <h3>Add the details</h3>
          <p>The event name, the date, the time and a line about it. Quiz, band, roast, whatever’s on.</p>
        </li>
        <li>
          <h3>It appears on your site</h3>
          <p>In seconds. Past events drop off automatically, so nobody has to tidy up.</p>
        </li>
      </ol>
    </div>

    <div class="mocks" role="group" aria-label="Example: the form on a phone, and the events list it creates on the website">
      <div class="phone">
        <div class="phone-notch" aria-hidden="true"></div>
        <div class="phone-screen">
          <p class="form-head">Add an event</p>
          <div class="field-mock">
            <span class="field-label">Event name</span>
            <span class="field-value">Quiz night</span>
          </div>
          <div class="field-mock two">
            <div>
              <span class="field-label">Date</span>
              <span class="field-value">Tue 17 Nov</span>
            </div>
            <div>
              <span class="field-label">Time</span>
              <span class="field-value">8pm</span>
            </div>
          </div>
          <div class="field-mock">
            <span class="field-label">A line about it</span>
            <span class="field-value">Teams of up to six. Bring a pen.</span>
          </div>
          <span class="submit-mock">Submit</span>
        </div>
      </div>

      <div class="site-mock">
        <div class="site-mock-bar" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="site-mock-body">
          <p class="site-mock-title">What’s on at your pub</p>
          <ul class="event-list">
            {events.map((e) => (
              <li>
                <span class="date-chip" aria-hidden="true"><b>{e.date}</b>{e.day}</span>
                <span class="event-text">
                  <strong>{e.name}</strong>
                  <span>{e.meta}. {e.note}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <p class="mock-caption">An example. Your pub’s name, your events.</p>
    </div>
  </div>
</section>
