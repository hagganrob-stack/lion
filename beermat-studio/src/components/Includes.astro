---
import Photo from './Photo.astro';
import { includes } from '../data/content';
---
<section class="section" id="included" aria-labelledby="inc-title">
  <div class="container">
    <h2 id="inc-title" class="h2 max-heading">What every pub website includes</h2>
    <ul class="tiles">
      {includes.map((item, i) => (
        <li class={`tile tile-${i + 1}`}>
          <Photo
            name={item.image}
            alt={item.alt}
            position={item.position}
            sizes={i === 0 ? '(min-width: 60rem) 50vw, 100vw' : '(min-width: 60rem) 25vw, 100vw'}
          />
          <div class="tile-scrim" aria-hidden="true"></div>
          <div class="tile-text">
            <h3 class="h3">{item.title}</h3>
            <p>{item.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
