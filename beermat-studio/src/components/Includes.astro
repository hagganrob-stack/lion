---
import { Picture } from 'astro:assets';
import garden from '../assets/photos/garden-pint.jpg';
import { includes } from '../data/content';
---
<section class="section section-board" id="included" aria-labelledby="inc-title">
  <div class="wrap">
    <div class="prose">
      <h2 id="inc-title">What every pub website includes</h2>
      <p class="intro">
        Whichever plan you choose, you get the things pub customers actually look for.
      </p>
    </div>
    <ul class="ticks">
      {includes.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ul>
    <div class="photo garden-photo">
      <Picture
        src={garden}
        alt="A glass of beer on a table in a pub garden in the evening, with string lights and people chatting."
        formats={['avif', 'webp']}
        widths={[480, 800, 1200]}
        sizes="(min-width: 64rem) 70rem, calc(100vw - 2rem)"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>
