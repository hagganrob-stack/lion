---
import Band from './Band.astro';
import garden from '../assets/photos/garden-pint.jpg';
import { includes } from '../data/content';
---
<Band image={garden} alt="" position="50% 35%" labelledby="inc-title" id="included">
  <div class="wrap band-copy">
    <h2 id="inc-title">What every pub website includes</h2>
    <p class="intro">Whichever plan you choose, you get the things pub customers actually look for.</p>
  </div>
</Band>
<section class="section section-board" aria-label="Included features">
  <div class="wrap">
    <ul class="ticks">
      {includes.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
