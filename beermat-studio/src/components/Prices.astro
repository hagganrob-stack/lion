---
import { tiers } from '../data/content';
---
<section class="section section-board" id="prices" aria-labelledby="prices-title">
  <div class="wrap">
    <div class="prose">
      <h2 id="prices-title">Pub website design prices</h2>
      <p class="intro">
        Pick a plan and pay monthly, or pay once on the two bigger plans.
      </p>
    </div>

    <div class="tiers">
      {tiers.map((t) => (
        <article class={`tier${t.featured ? ' tier-featured' : ''}`} aria-labelledby={`tier-${t.id}`}>
          {t.featured && <p class="clip">Most popular</p>}
          <h3 id={`tier-${t.id}`}>{t.name}</h3>
          <p class="tier-blurb">{t.blurb}</p>
          <p class="price">
            <span class="price-big">{t.upfront}</span>
            <span class="price-label"> upfront</span>
          </p>
          <p class="price-sub">
            then <strong>{t.monthly}</strong> a month for {t.term}
          </p>
          {t.oneOff && (
            <p class="price-alt">or <strong>{t.oneOff}</strong> one-off</p>
          )}
          {t.lead && <p class="tier-lead">{t.lead}</p>}
          <ul class="tier-list">
            {t.features.map((f) => <li>{f}</li>)}
          </ul>
          <a class={`btn ${t.featured ? 'btn-brass' : 'btn-red'}`} href="#enquire" data-plan={t.name}>
            Ask about {t.name}
          </a>
        </article>
      ))}
    </div>

    <p class="tiers-note">
      Once your plan ends, the site is yours. Optional hosting and support is £29 a month.
    </p>
  </div>
</section>
