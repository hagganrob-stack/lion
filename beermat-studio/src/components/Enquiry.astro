---
import { site, phoneHref, bookHref, bookIsExternal } from '../data/site';
---
<section class="section section-green on-dark" id="enquire" aria-labelledby="enquire-title">
  <div class="wrap enquire-grid">
    <div class="enquire-copy">
      <h2 id="enquire-title">Book a 15-minute call</h2>
      <p class="lede">
        Tell me about your pub and I’ll tell you straight whether this is a good fit.
        No hard sell, and no jargon.
      </p>
      {bookIsExternal && (
        <p>
          <a class="btn btn-brass" href={bookHref} data-book target="_blank" rel="noopener">Pick a time</a>
        </p>
      )}
      <p class="or-line">{bookIsExternal ? 'Or leave your details and I’ll get back to you.' : 'Leave your details and I’ll get back to you.'}</p>
      <ul class="contact-list">
        <li>Email: <a href={`mailto:${site.email}`}>{site.email}</a></li>
        {site.phone && <li>Phone: <a href={phoneHref}>{site.phone}</a></li>}
      </ul>
    </div>

    <div class="form-panel">
      <form id="enquiry-form" class="enquiry-form" method="post" action="/api/enquiry" novalidate>
        <div class="field">
          <label for="f-name">Your name</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="100" />
          <p class="err" id="e-name" hidden></p>
        </div>
        <div class="field">
          <label for="f-pub">Pub name</label>
          <input id="f-pub" name="pub" type="text" autocomplete="organization" required maxlength="120" />
          <p class="err" id="e-pub" hidden></p>
        </div>
        <div class="field">
          <label for="f-town">Town</label>
          <input id="f-town" name="town" type="text" autocomplete="address-level2" required maxlength="100" />
          <p class="err" id="e-town" hidden></p>
        </div>
        <div class="field">
          <label for="f-phone">Phone</label>
          <input id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required maxlength="30" />
          <p class="err" id="e-phone" hidden></p>
        </div>
        <div class="field">
          <label for="f-email">Email</label>
          <input id="f-email" name="email" type="email" inputmode="email" autocomplete="email" required maxlength="160" />
          <p class="err" id="e-email" hidden></p>
        </div>
        <div class="field">
          <label for="f-pubs">How many pubs?</label>
          <select id="f-pubs" name="pubs" required>
            <option value="">Choose one</option>
            <option>1</option>
            <option>2</option>
            <option>3</option>
            <option>4</option>
            <option>5</option>
            <option>6 or more</option>
          </select>
          <p class="err" id="e-pubs" hidden></p>
        </div>

        <!-- Spam trap: real people never see or fill this in. -->
        <div class="hp" aria-hidden="true">
          <label for="f-site">Leave this empty</label>
          <input id="f-site" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <input type="hidden" name="ft" value="" />
        <input type="hidden" name="plan" value="" />
        <input type="hidden" name="utm_source" value="" />
        <input type="hidden" name="utm_medium" value="" />
        <input type="hidden" name="utm_campaign" value="" />
        <input type="hidden" name="utm_content" value="" />
        <input type="hidden" name="utm_term" value="" />
        <input type="hidden" name="gclid" value="" />
        <input type="hidden" name="fbclid" value="" />
        <input type="hidden" name="landing_page" value="" />
        <input type="hidden" name="referrer" value="" />

        <button class="btn btn-brass btn-block" type="submit">Send my details</button>
        <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        <p class="form-fine">
          I’ll only use these details to reply to you. See the <a href="/privacy">privacy policy</a>.
        </p>
        <noscript>
          <p class="form-fine">This form needs JavaScript. You can also email {site.email}.</p>
        </noscript>
      </form>

      <div class="thanks" id="thanks" hidden tabindex="-1">
        <h3>Thanks, got it.</h3>
        <p>I’ll get back to you soon. If it’s urgent, email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      </div>
    </div>
  </div>
</section>
