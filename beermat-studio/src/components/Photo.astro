---
// A responsive photo: AVIF + WebP srcset, explicit width and height (from the file), lazy by default.
import { Picture } from 'astro:assets';
import { image } from '../lib/images';
interface Props {
  name: string;
  alt: string;
  sizes?: string;
  priority?: boolean;
  position?: string;
  class?: string;
}
const { name, alt, sizes = '100vw', priority = false, position = 'center', class: className } = Astro.props;
const src = image(name);
const widths = [480, 768, 1080, 1440, 1920].filter((w) => w <= src.width);
---
<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  widths={widths}
  sizes={sizes}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding={priority ? 'sync' : 'async'}
  class={className}
  style={`object-position:${position}`}
/>
