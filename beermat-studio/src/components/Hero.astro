---
import Band from './Band.astro';
import HeroMat from './HeroMat.astro';
import pour from '../assets/photos/pint-pour.jpg';
import { bookHref, bookIsExternal } from '../data/site';
---
<Band image={pour} alt="A pint being poured from the tap on a pub bar." priority tall position="55% 40%" labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title">Websites for pubs that keep up with what’s on.</h1>
      <p class="lede">
        Add quiz nights, live music and food nights from your phone using a simple Google Form,
        and they show on your website straight away. No logins, no website editor.
      </p>
      <div class="btn-row">
        <a class="btn btn-outline" href="#prices">See prices</a>
        <a
          class="btn btn-brass"
          href={bookHref}
          data-book
          target={bookIsExternal ? '_blank' : undefined}
          rel={bookIsExternal ? 'noopener' : undefined}
        >Book a 15-minute call</a>
      </div>
      <p class="small-line">Pay monthly from £39.</p>
    </div>
    <HeroMat />
  </div>
</Band>
