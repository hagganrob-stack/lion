---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { site, hasTracking } from '../data/site';
import { faqs } from '../data/content';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  schema?: boolean;
  solidHeader?: boolean;
}
const { title, description, path = '/', noindex = false, schema = false, solidHeader = false } = Astro.props;
const canonical = new URL(path, site.url).href;
const ogImage = `${site.url}/og.png`;

const professionalService = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#business`,
  name: site.name,
  url: site.url,
  image: ogImage,
  description,
  serviceType: 'Pub website design',
  areaServed: { '@type': 'Country', name: 'United Kingdom' },
  address: { '@type': 'PostalAddress', addressLocality: site.town, addressCountry: 'GB' },
  email: site.email,
  ...(site.phone ? { telephone: site.phone } : {}),
  founder: { '@type': 'Person', name: site.founder },
  priceRange: '£39 to £69 a month',
};
const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0b0907" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A Beermat Studio beermat listing what's on at a pub: Tuesday quiz, Friday live music, Sunday roast." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href="/fonts/oswald-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-4-400.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <script is:inline>document.documentElement.classList.add("js")</script>

    {schema && <script type="application/ld+json" set:html={JSON.stringify(professionalService)} />}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(faqPage)} />}
  </head>
  <body data-meta-pixel={site.metaPixelId} data-ga4={site.ga4Id}>
    <a class="skip-link" href="#main">Skip to the content</a>
    <Header solid={solidHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {hasTracking && <ConsentBanner />}
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
