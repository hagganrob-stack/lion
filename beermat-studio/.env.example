# Copy to .env for local work. On Vercel, add these under Project Settings > Environment Variables.

# --- Enquiry form (server only, used by api/enquiry.js) ---
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=
# Where enquiries are emailed to (you).
LEAD_TO_EMAIL=
# Must be on a domain you've verified in Resend, e.g. "Beermat Studio <enquiries@beermat.studio>"
RESEND_FROM=

# --- Meta Conversions API (optional, server only) ---
# Leave blank to skip the server-side Lead event. The browser Pixel still works.
META_CAPI_TOKEN=
# Optional: only needed if you want to change the Graph API version.
META_GRAPH_VERSION=
# Optional: Events Manager > Test events code, for checking the server event. Remove after testing.
META_TEST_EVENT_CODE=

# --- Tracking IDs (public, baked in at build time) ---
# Nothing loads until a visitor accepts cookies. If both are blank the cookie banner is not shown.
PUBLIC_META_PIXEL_ID=
PUBLIC_GA4_ID=
